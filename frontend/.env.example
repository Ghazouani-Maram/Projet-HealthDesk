# URL de l'API vue par le navigateur.
# Derrière le reverse proxy : /api (le proxy route /api vers le backend).
VITE_API_URL=/api
# Uniquement pour `npm run dev` : adresse du backend local
VITE_DEV_API=http://localhost:8000
# Mode démo : API simulée dans le navigateur (aucun backend requis). true ou false
VITE_DEMO=false
