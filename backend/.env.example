# Base SQLite : aucun logiciel à installer (fichier healthdesk.db créé automatiquement)
DATABASE_URL=sqlite:///./healthdesk.db
# Base PostgreSQL (docker compose up -d db) :
# DATABASE_URL=postgresql+psycopg://healthdesk:change_me@localhost:5432/healthdesk

# Clé de signature des jetons JWT : à remplacer par une valeur longue et aléatoire
SECRET_KEY=dev-only-secret-change-me-before-any-deployment-0123456789
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
# Crée un compte admin, des médecins, des patients et des rendez-vous de démonstration si la base est vide
SEED_DEMO_DATA=true
